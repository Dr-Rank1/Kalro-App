# ============================================================================
# KALRO Sericulture Cloud Backend API - Environment Configuration
# ============================================================================

# Application Environment (development, test, production)
NODE_ENV=development

# Safaricom Daraja API Credentials
# Choose 'sandbox' for staging/testing or 'production' for live M-PESA B2C
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Daraja B2C Configuration
# Sandbox Shortcode is usually 600999 or 600000; Production is assigned by Safaricom
DARAJA_SHORTCODE=600999
DARAJA_INITIATOR_NAME=testapi
# Plaintext or certificate-encrypted initiator password/security credential
DARAJA_SECURITY_CREDENTIAL=your_encrypted_security_credential_here
# CommandID: BusinessPayment (default for farmer purchase), SalaryPayment, or PromotionPayment
DARAJA_COMMAND_ID=BusinessPayment

# Webhook Callback URLs (Vercel deployment domain or ngrok public tunnel in dev)
DARAJA_CALLBACK_URL=https://your-domain.vercel.app/api/payout/callback
DARAJA_TIMEOUT_URL=https://your-domain.vercel.app/api/payout/callback?timeout=true

# MongoDB Atlas Ledger Configuration
MONGODB_URI=mongodb+srv://kalro_admin:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kalro_sericulture

# Optional: Enable simulation mode when Daraja credentials are not yet provisioned
DARAJA_SIMULATION=false
